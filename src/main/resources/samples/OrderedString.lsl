OrderedString(E, Str): trait
  assumes TotalOrder(E)
  includes DerivedOrders(Str)
  introduces
    empty: → Str
    __ -| __: E, Str → Str
    __ ∉ __: Str, Str → Bool
  asserts
    Str generated by empty, -|
    e, e1: E, s, s1: Str
    empty ∉ (e -| s);
    s ∉ empty;
    (e -| s) ∉ (e1 -| s1) ==
      e ≠ e1 ∧ e ∉ (e1 -| s1) ∧ s ∉ s1;
  implies TotalOrder(Str)
